Ddoc

$(CHANGELOG_NAV_INJECT)

$(VERSION Aug 05, 2026, =================================================,

$(CHANGELOG_HEADER_STATISTICS
$(VER) comes with 17 fixed Github issues.
        A huge thanks goes to the
        $(LINK2 #contributors, 10 contributors)
        who made $(VER) possible.)

$(CHANGELOG_SEP_NO_TEXT_BUGZILLA)

$(BUGSTITLE_GITHUB DMD Compiler bug fixes,

$(LI $(DMDGITHUB 22323): [Regression master]  error "cannot get frame pointer" with AA in struct literal)
$(LI $(DMDGITHUB 22354): [REG master] `aa[key] ~= null` discarded)
$(LI $(DMDGITHUB 22386): [REG 2.112] Indexed initialization of multi dimensional const array does not compile.)
$(LI $(DMDGITHUB 22406): [REG 2.112] Error: function '_d_aaLen' is not callable using argument types '$(LPAREN)shared$(LPAREN)int[int]$(RPAREN)$(RPAREN)')
$(LI $(DMDGITHUB 22422): [REG 2.112.0] Missing _d_cast lowering for CommaExp)
$(LI $(DMDGITHUB 22480): Regression in DMD v2.112, betterC can not work with CTFE associative array any more)
$(LI $(DMDGITHUB 22501): [REG 2.112] GC allocation for CTFE-available static array.)
$(LI $(DMDGITHUB 22510): dup of inout aa broke with 2.112)
$(LI $(DMDGITHUB 22535): [REG 2.112] Unicode symbols inside q)
$(LI $(DMDGITHUB 22544): [REG 2.112] Cannot index AA in `with` block)
$(LI $(DMDGITHUB 22556): [REG 2.112] `shared` AAs with RefCounted values don't work even after removing shared)
$(LI $(DMDGITHUB 22567): [REG 2.112] `alias this` and nested AAs cause compiler SIGILL)
$(LI $(DMDGITHUB 22594): [REG 2.101] TypeInfo_Class.m_flags wrong wrt. noPointers flag when the only pointers come from tuple members)
$(LI $(DMDGITHUB 22625): undefined identifier 'addr' in core.sys.posix.netinet.in_.IN6*)
)
$(BUGSTITLE_GITHUB Phobos bug fixes,

$(LI $(DMDGITHUB 22388): 2.112 Not compile mixin Signal!$(LPAREN)string, int$(RPAREN);)
$(LI $(PHOBOSGITHUB 10920): gammaIncomplete$(LPAREN)M,M$(RPAREN) fails to return when M >= 1e20)
$(LI $(PHOBOSGITHUB 10965): normalDistribution doesn't handle edge cases ±∞)
)
)
$(D_CONTRIBUTORS_HEADER 10)
$(D_CONTRIBUTORS
    $(D_CONTRIBUTOR Dennis)
    $(D_CONTRIBUTOR Dennis Korpel)
    $(D_CONTRIBUTOR Divyansh Sharma)
    $(D_CONTRIBUTOR Iain Buclaw)
